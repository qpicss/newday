# /etc/oauth-gateway/gateway.env (Linux) or docker run --env-file. All values are optional.

# Pull mode: the console's gateway link address. With it the node registers itself, pulls its
# configuration, reports usage and verifies admin UI sign-ins; no inbound management port is needed.
# GATEWAY_MANAGEMENT_URL=https://console.example.com:3443
# Name shown in the console (defaults to the host name)
# GATEWAY_NODE_NAME=node-1
# Management address the console can also push to (optional in pull mode)
# GATEWAY_ADVERTISE_URL=https://10.0.0.5:9443
# GATEWAY_POLL_INTERVAL_MS=15000
# GATEWAY_HEARTBEAT_INTERVAL_MS=30000
# GATEWAY_USAGE_INTERVAL_MS=60000

# mTLS endpoint the management console pushes configuration to (push mode)
GATEWAY_MANAGEMENT_PORT=9443
GATEWAY_MANAGEMENT_HOST=0.0.0.0

# Admin UI (HTTPS, gateway certificate). Org admins sign in with their console credentials.
GATEWAY_ADMIN_ENABLED=true
GATEWAY_ADMIN_PORT=9445
GATEWAY_ADMIN_HOST=0.0.0.0

# Plain HTTP /healthz, /readyz and Prometheus /metrics
GATEWAY_HEALTH_PORT=9080
GATEWAY_HEALTH_HOST=0.0.0.0

# Address connection handlers (API traffic ports) listen on
GATEWAY_BIND_HOST=0.0.0.0

# Requests larger than this are rejected with 413
GATEWAY_MAX_BODY_BYTES=10485760
# Default upstream timeout for APIs without a connection
GATEWAY_UPSTREAM_TIMEOUT_MS=30000

# Rate limits shared exactly across a cluster. Without Redis each node enforces its share.
# GATEWAY_REDIS_URL=redis://redis:6379

# Worker threads that run policies
GATEWAY_POLICY_WORKERS=2

# debug, info, warn, error
GATEWAY_LOG_LEVEL=info
