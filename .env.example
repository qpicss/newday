PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=newday
DB_USER=root
DB_PASSWORD=
JWT_SECRET=replace-with-a-long-random-string
# DB_DIALECT=sqlite
# DB_STORAGE=./dev.sqlite
# DB_SYNC_ALTER=true

# Public URL used in invitation links (recommended in production)
# APP_URL=https://console.example.com

# SMTP for invitation emails. Without SMTP_HOST, invite links are shown in the UI to share manually.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="OAuth Server <no-reply@example.com>"

# Encrypts private keys stored in the database (management CA, gateway handler certificates).
# 32 random bytes, base64: openssl rand -base64 32
# Without it a key is derived from JWT_SECRET, so changing JWT_SECRET would make them unreadable.
# PKI_MASTER_KEY=

# Gateway link: mTLS listener gateways call to register, pull configuration, report usage and
# verify admin UI sign-ins. Only certificates issued by the management CA are accepted.
# GATEWAY_LINK_ENABLED=true
# GATEWAY_LINK_PORT=3443
# GATEWAY_LINK_HOST=0.0.0.0
# Address gateways use; its host name goes into the link certificate (default: APP_URL host, port 3443)
# GATEWAY_LINK_PUBLIC_URL=https://console.example.com:3443

# Push gateways with auto-push on a few seconds after changes (false turns it off everywhere)
# GATEWAY_AUTO_PUSH=true
# GATEWAY_AUTO_PUSH_DELAY_MS=2000
# How often usage is collected from push nodes (pull nodes report it themselves)
# GATEWAY_USAGE_COLLECT_MS=60000
# How often the console checks the nodes it connects to (push nodes) and resends the deployed
# configuration to one that came back with an older one; 0 turns it off
# GATEWAY_MONITOR_MS=30000
